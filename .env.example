# Public backend origin used by the statically compiled web and Android clients.
# It is intentionally NEXT_PUBLIC_: it is visible in browser/ APK bundles.
# Use an HTTPS origin in public and release builds, without /v1 or a trailing slash.
# Example: https://api.example.com
NEXT_PUBLIC_API_BASE_URL=
# Public HTTPS web origin used when sharing duel links from Android.
NEXT_PUBLIC_PUBLIC_WEB_ORIGIN=https://example.com/rango90

# Do not add database passwords, API keys, signing keys, or other secrets here.
# Backend-only variables belong in backend/.env and are never bundled by Next.js.
