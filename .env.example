# Frontend/public variables (required in public and release builds).
# These values are compiled into browser/APK bundles and must never be secrets.
# Obtain the API origin from the deployed backend owner; omit /v1 and the final slash.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# Public HTTPS origin used when sharing duel links from Android.
NEXT_PUBLIC_PUBLIC_WEB_ORIGIN=https://web.example.com/rango90

# Backend-only variables belong in backend/.env and are never bundled by Next.js.
# Use backend/.env.example as the local/CI/production variable checklist.
