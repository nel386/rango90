NODE_ENV=development
PORT=4000
POSTGRES_DB=rango90
POSTGRES_USER=rango90
POSTGRES_PASSWORD=rango90-local-dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://rango90:rango90-local-dev@localhost:5432/rango90
CORS_ORIGIN=http://localhost:3000
# Comma-separated origins are allowed; use HTTPS-only origins in production.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_READ_MAX=120
# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
AUTH_FRONTEND_ORIGIN=http://localhost:3000/es/
AUTH_VERIFICATION_BASE_URL=http://localhost:4000/v1/auth/verify-email
AUTH_COOKIE_SAMESITE=lax
# Required in production: POST { to, verificationUrl } to your email delivery service.
# In development, the verification URL is logged locally.
AUTH_EMAIL_WEBHOOK_URL=
# Google OAuth is optional until credentials and a callback URL exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=replace-with-your-api-football-key
API_FOOTBALL_TIMEOUT_MS=15000
API_FOOTBALL_PAGE_DELAY_MS=300
# Optional: FootyStats Football Data API, used for historical Copa Sudamericana goalkeeper clean sheets.
FOOTYSTATS_API_KEY=replace-with-your-footystats-key
# TheSportsDB is only an artwork candidate source. The public key 123 is for development;
# do not treat it as a production/app-store license. Set a paid key after rights review.
THE_SPORTS_DB_BASE_URL=https://www.thesportsdb.com/api/v1/json/123
THE_SPORTS_DB_MIN_REQUEST_INTERVAL_MS=2100
THE_SPORTS_DB_MAX_ATTEMPTS=3
# Optional OAuth2 credentials for the Openverse API. Register at:
# https://api.openverse.org/v1/#tag/auth/operation/register
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
OPENVERSE_TIMEOUT_MS=15000
OPENVERSE_MIN_REQUEST_INTERVAL_MS=1000
MEDIA_ROOT=./storage/media
SNAPSHOT_ROOT=./storage/source-snapshots
MEDIA_CANDIDATE_ROOT=./storage/media-candidates
# Sustituye el contacto por un correo o URL real del proyecto antes de consultar Commons.
MEDIA_USER_AGENT=Rango90/0.1 (contacto-del-proyecto)
MEDIA_MAX_ATTEMPTS=3
MEDIA_DISCOVERY_MAX_ATTEMPTS=1
MEDIA_RETRY_MAX_MS=10000
MEDIA_REQUEST_TIMEOUT_MS=15000
MEDIA_DISCOVERY_REQUEST_TIMEOUT_MS=7000
# Intervalo mínimo entre llamadas a API/REST de Wikimedia Commons.
COMMONS_MIN_REQUEST_INTERVAL_MS=500
