# Local development defaults. Do not copy these values to production.
NODE_ENV=development
RANGO90_RUNTIME_MODE=lab
PORT=4000

# Local PostgreSQL (required for local backend/tests that use a database).
POSTGRES_DB=rango90
POSTGRES_USER=rango90
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rango90:change-me-local-only@127.0.0.1:5432/rango90

# Browser/API boundary (required; use HTTPS origins in production).
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_READ_MAX=120
TRUST_PROXY=false
AUTH_FRONTEND_ORIGIN=http://localhost:3000/es/
AUTH_VERIFICATION_BASE_URL=http://localhost:4000/v1/auth/verify-email
AUTH_COOKIE_SAMESITE=lax

# Optional in local/lab; required in production. Set to the email delivery webhook.
AUTH_EMAIL_WEBHOOK_URL=

# Optional OAuth credentials. Obtain them from the Google Cloud project owner.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback

# Provider credentials. Obtain them from each provider account owner; never commit values.
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=replace-with-api-football-key
API_FOOTBALL_TIMEOUT_MS=15000
API_FOOTBALL_PAGE_DELAY_MS=300
FOOTYSTATS_API_KEY=replace-with-footystats-key
# Artwork candidate source only. Obtain a provider key after rights review.
THE_SPORTS_DB_BASE_URL=https://www.thesportsdb.com/api/v1/json/replace-with-sportsdb-key
THE_SPORTS_DB_MIN_REQUEST_INTERVAL_MS=2100
THE_SPORTS_DB_MAX_ATTEMPTS=3
# Optional OAuth2 credentials for Openverse. Register at:
# https://api.openverse.org/v1/#tag/auth/operation/register
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
OPENVERSE_TIMEOUT_MS=15000
OPENVERSE_MIN_REQUEST_INTERVAL_MS=1000

# Local storage roots (required; keep generated storage outside Git).
MEDIA_ROOT=./storage/media
SNAPSHOT_ROOT=./storage/source-snapshots
MEDIA_CANDIDATE_ROOT=./storage/media-candidates
# Replace the placeholder with a project contact URL before querying Commons.
MEDIA_USER_AGENT=Rango90/0.1 (project-contact-url)
MEDIA_MAX_ATTEMPTS=3
MEDIA_DISCOVERY_MAX_ATTEMPTS=1
MEDIA_RETRY_MAX_MS=10000
MEDIA_REQUEST_TIMEOUT_MS=15000
MEDIA_DISCOVERY_REQUEST_TIMEOUT_MS=7000
COMMONS_MIN_REQUEST_INTERVAL_MS=500
